# Обязательные переменные
DASHBOARD_ACCESS_PASSWORD=replace-with-viewer-password
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-random-string-at-least-32-characters
DASHBOARD_ADMIN_PASSWORD=replace-with-admin-password
DASHBOARD_ADMIN_TOKEN_SECRET=replace-with-another-random-string-at-least-32-characters
YANDEX_MAPS_API_KEY=replace-with-yandex-maps-key

# Чтение рабочего Excel — заполните один из вариантов
NEXTCLOUD_EXCEL_URL=https://nextcloud.example/download/dashboard_data.xlsx
# NEXTCLOUD_EXCEL_PUBLIC_FOLDER_URL=https://nextcloud.example/index.php/s/share-token
# NEXTCLOUD_EXCEL_FILE_PATH=dashboard_data.xlsx
# NEXTCLOUD_EXCEL_SHARE_PASSWORD=

# Двусторонняя запись статусов
NEXTCLOUD_EXCEL_WRITE_ENABLED=true
NEXTCLOUD_EXCEL_WRITE_SHARE_URL=https://nextcloud.example/index.php/s/share-token
# NEXTCLOUD_EXCEL_WRITE_SHARE_PASSWORD=

# Необязательные параметры
# DASHBOARD_REFRESH_SECONDS=30
# NEXTCLOUD_EXCEL_TIMEOUT_MS=15000
# NEXTCLOUD_EXCEL_WRITE_TIMEOUT_MS=10000
# NEXTCLOUD_PHOTO_PUBLIC_FOLDER_URL=https://nextcloud.example/index.php/s/photo-share-token
# NEXTCLOUD_PHOTO_VERSION=20260729-v1183
